  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ASRS_Pallet_Circulation_Diagram
  sequenceManager: {fileID: 0}
  root: {fileID: 3677759489798379441}
  completionHoldSeconds: 2
  walkthroughActionPrefix: M1_Flow_
  animationActionId: M1_PalletCirculation
  stages:
  - title: Raw material into storage
    description: Raw materials are loaded into templates, and the loaded templates
      are stored in addressable ASRS cells.
    node: {fileID: 2762187086548578574}
    sceneHighlights: []
  - title: Robot retrieval
    description: When a job needs a part, the ASRS robot retrieves the requested
      template from its cell.
    node: {fileID: 3392544054420078006}
    sceneHighlights: []
  - title: Conveyor & PLC routing
    description: The template rides a pallet onto the conveyor. PLC-controlled logic
      routes the pallet to the station that needs it.
    node: {fileID: 2672061538268514038}
    sceneHighlights: []
  - title: Processing stations
    description: "CNC and assembly stations machine and assemble the parts. (Shown
      as a concept \u2014 those stations aren't modelled in this scene.)"
    node: {fileID: 6022107482829938217}
    sceneHighlights: []
  - title: Return conveyor
    description: Processed parts go back onto the conveyor, which carries the pallet
      back toward the ASRS.
    node: {fileID: 6502524479891650556}
    sceneHighlights: []
  - title: Finished goods stored
    description: The completed product is stored back in the ASRS as a finished good,
      ready for the next request.
    node: {fileID: 2762187086548578574}
    sceneHighlights: []
