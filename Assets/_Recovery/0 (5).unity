--- !u!114 &436308603
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 436308601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 308e3640226ceb346b1cfcac31db9c62, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  steps:
  - target: {fileID: 1958909702}
    highlightVisual: {fileID: 1297202229}
    infoText: "This is the ASRS \u2014 Automated Storage and Retrieval System. It
      stores raw materials, work-in-progress parts, and finished goods as they move
      through the CIM cell."
  - target: {fileID: 2344116719856461000}
    highlightVisual: {fileID: 56191373}
    infoText: The conveyor belt carries pallets between stations. Once the ASRS releases
      a pallet, the conveyor moves it to the next step in the process.
  - target: {fileID: 840883474}
    highlightVisual: {fileID: 1181472682}
    infoText: '"This is the slotted table buffer. It holds pallets temporarily when
      a station isn''t ready to receive them yet, preventing a backup in the line.'
  - target: {fileID: 243334516}
    highlightVisual: {fileID: 1334427743}
    infoText: "\"This is the epoxy block \u2014 one of the standard parts used in
      this CIM cell. Its template is shaped specifically to hold this part and no
      other.\""
  - target: {fileID: 749321896}
    highlightVisual: {fileID: 94642706}
    infoText: '"This is the RFID sensor. It scans each pallet''s tag as it passes,
      so the system always knows which part is where."'
  - target: {fileID: 893968567}
    highlightVisual: {fileID: 1333149791}
    infoText: '"Both the ASRS-36 and ASRS-36u have access doors with handles like
      this. Opening either door during operation immediately halts the robot for
      safety."'
  - target: {fileID: 893968566}
    highlightVisual: {fileID: 1398550418}
    infoText: '"Both the ASRS-36 and ASRS-36u have access doors with handles like
      this. Opening either door during operation immediately halts the robot for
      safety."'
  - target: {fileID: 1237211079}
    highlightVisual: {fileID: 47815885}
    infoText: "\"This is the gripper \u2014 sometimes called the hand. It's mounted
      on the robotic arm and physically picks up and places templates as they move
      between the rack and the conveyor.\""
  - target: {fileID: 315783216}
    highlightVisual: {fileID: 1396720222}
    infoText: '"Every ASRS station has an emergency stop button like this one. Pressing
      it stops all motion immediately, on either the 36 or the 36u."'
  - target: {fileID: 151351295}
    highlightVisual: {fileID: 1259211282}
    infoText: '"Every ASRS station has an emergency stop button like this one. Pressing
      it stops all motion immediately, on either the 36 or the 36u."'
  infoPanel: {fileID: 493804593}
  completionText: "Great job \u2014 you've identified every part. Let's test what
    you've learned."
  onSequenceComplete:
    m_PersistentCalls:
      m_Calls: []
