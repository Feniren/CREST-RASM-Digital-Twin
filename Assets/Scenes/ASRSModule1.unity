  m_Script: {fileID: 11500000, guid: 317bc38441019af4d97ae318445d5678, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ASRS_Module1_Quiz
  sequenceManager: {fileID: 1628413926}
  root: {fileID: 1996102243}
  completionHoldSeconds: 2
  quizActionId: M1_QuizPassed
  questions:
  - prompt: Which storage station rotates its storage positions to bring the requested
      part to one fixed load/unload point, instead of a robot travelling to the part?
    options:
    - Carousel
    - ASRS-36x2
    - ASRS-36x2u
    correctOption: 0
    explanation: The carousel turns to bring stock to one fixed access point. The
      ASRS-36x2 and ASRS-36x2u use a Cartesian robot that travels to an addressed
      cell instead.
    rackCellQuestion: 0
    cellTableId: 
  - prompt: After the CNC and assembly stations finish processing a part, where does
      it go?
    options:
    - Back onto the conveyor and into the ASRS, stored as a finished good
    - It stays on the CNC machine until the next job starts
    - Into the carousel, where it becomes raw material again
    - The ASRS robot carries it straight from the CNC machine
    correctOption: 0
    explanation: "Processed parts return on the conveyor and the completed product
      is stored back in the ASRS \u2014 the ASRS holds raw material, work-in-process
      and finished goods."
    rackCellQuestion: 0
    cellTableId: 
  - prompt: A job needs a {material}. Using the rack's inventory, select a storage
      cell that holds one.
    options: []
    correctOption: 0
    explanation: "Every cell has an address and the rack's inventory records what
      each one holds \u2014 that's how the ASRS finds a part without searching."
    rackCellQuestion: 1
    cellTableId: 020001
  passMark: 2
  cellInspector: {fileID: 1607586618}
