<?xml version="1.0" ?>
<!--
  Motoman GP8 - Flat URDF for Unity (URDF Importer)
  Source: ros-industrial/motoman (kinetic-devel), motoman_gp8_support
  Xacro macros resolved; package:// paths adjusted for Unity import.
-->
<robot name="motoman_gp8">

  <!-- Materials -->
  <material name="yaskawa_blue">
    <color rgba="0.1294 0.1490 0.7490 1.0"/>
  </material>

  <!-- ==================== LINKS ==================== -->

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/visual/gp8_base_link.stl"/>
      </geometry>
      <material name="yaskawa_blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/collision/gp8_base_link.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_1_s">
    <visual>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/visual/gp8_link_1_s.stl"/>
      </geometry>
      <material name="yaskawa_blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/collision/gp8_link_1_s.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_2_l">
    <visual>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/visual/gp8_link_2_l.stl"/>
      </geometry>
      <material name="yaskawa_blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/collision/gp8_link_2_l.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_3_u">
    <visual>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/visual/gp8_link_3_u.stl"/>
      </geometry>
      <material name="yaskawa_blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/collision/gp8_link_3_u.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_4_r">
    <visual>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/visual/gp8_link_4_r.stl"/>
      </geometry>
      <material name="yaskawa_blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/collision/gp8_link_4_r.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_5_b">
    <visual>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/visual/gp8_link_5_b.stl"/>
      </geometry>
      <material name="yaskawa_blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/collision/gp8_link_5_b.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link_6_t">
    <visual>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/visual/gp8_link_6_t.stl"/>
      </geometry>
      <material name="yaskawa_blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://motoman_gp8/meshes/collision/gp8_link_6_t.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Flange and tool frames (no geometry) -->
  <link name="flange"/>
  <link name="tool0"/>
  <link name="base"/>

  <!-- ==================== JOINTS ==================== -->

  <joint name="joint_1_s" type="revolute">
    <parent link="base_link"/>
    <child link="link_1_s"/>
    <origin xyz="0 0 0.330" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="150.92" velocity="7.9412"/>
  </joint>

  <joint name="joint_2_l" type="revolute">
    <parent link="link_1_s"/>
    <child link="link_2_l"/>
    <origin xyz="0.040 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.1345" upper="2.5307" effort="176.4" velocity="6.7200"/>
  </joint>

  <joint name="joint_3_u" type="revolute">
    <parent link="link_2_l"/>
    <child link="link_3_u"/>
    <origin xyz="0 0 0.345" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.2217" upper="3.3161" effort="107.56" velocity="9.0757"/>
  </joint>

  <joint name="joint_4_r" type="revolute">
    <parent link="link_3_u"/>
    <child link="link_4_r"/>
    <origin xyz="0.340 0 0.040" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.3161" upper="3.3161" effort="55.86" velocity="9.5993"/>
  </joint>

  <joint name="joint_5_b" type="revolute">
    <parent link="link_4_r"/>
    <child link="link_5_b"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.3562" upper="2.3562" effort="32.68" velocity="9.5993"/>
  </joint>

  <joint name="joint_6_t" type="revolute">
    <parent link="link_5_b"/>
    <child link="link_6_t"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="22.54" velocity="17.4533"/>
  </joint>

  <!-- Flange: attachment point for end effectors -->
  <joint name="joint_6_t-flange" type="fixed">
    <parent link="link_6_t"/>
    <child link="flange"/>
    <origin xyz="0.080 0 0" rpy="0 0 0"/>
  </joint>

  <!-- tool0: ROS-Industrial standard all-zeros tool frame -->
  <joint name="flange-tool0" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="3.14159265 -1.57079633 0"/>
  </joint>

  <!-- base: manufacturer world coordinate frame -->
  <joint name="base_link-base" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0.330" rpy="0 0 0"/>
  </joint>

</robot>
